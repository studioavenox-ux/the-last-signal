@tool
extends Node3D
## Editor-visible, station-only preview generated by the production station builder.
## The gameplay entry scene remains `res://scenes/main.tscn`

const StationBuilder = preload("res://scripts/station_builder.gd")
const STATION_ROOT_NAME := "NirvaHalt"
const PREVIEW_CAMERA_NAME := "PreviewCamera"


func _ready() -> void:
	# Tool scripts may receive editor reloads. Reuse the generated subtree instead of
	# appending another complete station each time the scene is re-entered.
	if get_node_or_null(STATION_ROOT_NAME) == null:
		StationBuilder.new().build(self)
	_ensure_preview_camera()


func _ensure_preview_camera() -> void:
	if get_node_or_null(PREVIEW_CAMERA_NAME) != null:
		return
	var camera := Camera3D.new()
	camera.name = PREVIEW_CAMERA_NAME
	camera.position = Vector3(29.0, 21.0, 27.0)
	add_child(camera)
	camera.look_at(Vector3(0.0, 1.0, -10.0), Vector3.UP)
	camera.fov = 55.0
	camera.current = true
